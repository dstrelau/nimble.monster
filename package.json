{
  "name": "nimble-nexus",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "next build",
    "check:server-actions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/check-server-actions.ts",
    "dev": "next dev --turbopack",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node tools/seed.mjs",
    "feature-flag": "node tools/set-feature-flag.mjs",
    "image-renderer:bundle": "esbuild tools/image-renderer/server.ts --bundle --platform=node --format=esm --target=node24 --external:puppeteer-core --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=tmp/image-renderer.mjs",
    "image-renderer:deploy": "pnpm run image-renderer:bundle && node tools/image-renderer/deploy.mjs tmp/image-renderer.mjs",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "node": {
    "child_process": "empty"
  },
  "browser": {
    "child_process": false
  },
  "resolve": {
    "fallback": {
      "child_process": false
    }
  },
